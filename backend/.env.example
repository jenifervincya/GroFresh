PORT=4000
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgres://user:password@localhost:5432/grofresh

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=30d

# OTP
OTP_TTL_SECONDS=300
OTP_LENGTH=6

# SMS gateway - Twilio (set SMS_PROVIDER=twilio to enable; falls back to
# console-log stub otherwise)
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# AI fair-price engine (Neha) - confirmed synchronous, needs real base URL
PRICING_ENGINE_URL=

# Kafka - comma-separated broker list, e.g. localhost:9092 or a managed
# broker's bootstrap servers (Upstash Kafka, Confluent Cloud, etc). Falls
# back to a console-warning no-op if unset - server still boots without it.
KAFKA_BROKERS=
KAFKA_SSL=false
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# S3 (KYC document uploads) - set STORAGE_PROVIDER=s3 to enable; falls back
# to a local-URL stand-in otherwise
STORAGE_PROVIDER=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
UPLOAD_BASE_URL=http://localhost:4000
