PORT=4000
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgres://user:password@localhost:5432/grofresh

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=30d

# OTP
OTP_TTL_SECONDS=300
OTP_LENGTH=6

# SMS gateway (fill in once confirmed with Tamil - Q7)
SMS_GATEWAY_API_KEY=
SMS_GATEWAY_BASE_URL=
